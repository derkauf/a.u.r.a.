<!--
  Scan button (Phase 3), next to the gear: a small round button in the
  style of the Horizon OS quick settings. Pinch opens and closes the Tag
  scanner window (tag-scanner.uikitml), which turns on the passthrough
  camera to read the AprilTags. The whole element is the button
  (id scan-button); the ray over it scales it up (hover-scale-system).
-->
<style>
  .scan {
    width: 48px;
    height: 48px;
    background-color: #2f4052;
    border-width: 1px;
    border-color: #62e2ef;
    border-radius: 24px;
    justify-content: center;
    align-items: center;
    cursor: pointer;
  }

  .scan-icon {
    width: 24px;
    height: 24px;
    color: #62e2ef;
  }
</style>
<div id="scan-button" class="scan">
  <ScanLine class="scan-icon" />
</div>
