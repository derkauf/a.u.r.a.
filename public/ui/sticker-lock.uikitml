<!--
  Sticker AprilTag — Fechadura da porta (lock-porta-01).
  Representação SIMPLIFICADA no estilo tag36h11 (id 3): a grade
  6x6 é ilustrativa e NÃO é um codeword válido — este sticker na tela
  não é escaneável de verdade. O botão mostra o nome do dispositivo: o
  primeiro pinch simula a leitura ("a câmera leu o tag") e abre o painel;
  os seguintes abrem e fecham o painel. Gerado por
  tools/generate-apriltag-stickers.py. Os tags imprimíveis de verdade
  estão em docs/apriltag-markers.md.
-->
<style>
  .sticker-root {
    flex-direction: column;
    width: 260px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    padding-right: 20px;
    gap: 12px;
    background-color: #ffffff;
    border-radius: 16px;
    align-items: center;
  }

  .tag-grid {
    flex-direction: column;
  }

  .tag-row {
    flex-direction: row;
  }

  .cell-on {
    width: 16px;
    height: 16px;
    background-color: #111111;
  }

  .cell-off {
    width: 16px;
    height: 16px;
    background-color: #ffffff;
  }

  .sticker-sub {
    color: #5a6472;
    font-size: 16px;
    text-align: center;
  }

  .scan-button {
    min-height: 56px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: #2a9d8f;
    border-radius: 12px;
    justify-content: center;
    align-items: center;
    align-self: stretch;
  }

  .scan-label {
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
    text-align: center;
  }
</style>
<Panel class="sticker-root">
  <div class="tag-grid">
    <div class="tag-row"><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div></div>
    <div class="tag-row"><div class="cell-on"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-on"></div></div>
    <div class="tag-row"><div class="cell-on"></div><div class="cell-on"></div><div class="cell-off"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-off"></div><div class="cell-on"></div></div>
    <div class="tag-row"><div class="cell-on"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-on"></div><div class="cell-off"></div><div class="cell-on"></div><div class="cell-on"></div></div>
    <div class="tag-row"><div class="cell-on"></div><div class="cell-on"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-on"></div><div class="cell-off"></div><div class="cell-on"></div></div>
    <div class="tag-row"><div class="cell-on"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-on"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-on"></div><div class="cell-on"></div></div>
    <div class="tag-row"><div class="cell-on"></div><div class="cell-off"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-off"></div><div class="cell-on"></div><div class="cell-off"></div><div class="cell-on"></div></div>
