      <div class="tag-row"><div class="cell-on"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-on"></div></div>
      <div class="tag-row"><div class="cell-on"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-on"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-on"></div><div class="cell-on"></div></div>
      <div class="tag-row"><div class="cell-on"></div><div class="cell-on"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-on"></div><div class="cell-on"></div></div>
      <div class="tag-row"><div class="cell-on"></div><div class="cell-on"></div><div class="cell-off"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div></div>
