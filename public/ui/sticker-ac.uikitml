<!--
  Ícone do tag — Ar-condicionado da sala (ac-sala-01), AprilTag tag36h11 id 2.
  Visual de ícone de app do Horizon OS: o tag num quadrado branco, o nome
  do dispositivo embaixo. A grade 6x6 é ilustrativa e NÃO é um codeword
  válido. O ícone inteiro é o botão (id sticker-scan-button): o primeiro
  pinch simula a leitura ("a câmera leu o tag") e abre o painel; os
  seguintes abrem e fecham. O raio por cima aumenta o ícone (hover, em
  src/ui/hover-scale-system.ts). Gerado por tools/generate-apriltag-stickers.py.
  Os tags imprimíveis de verdade estão em docs/apriltag-markers.md.
-->
<style>
  .icon-root {
    flex-direction: column;
    align-items: center;
    width: 140px;
    gap: 8px;
    cursor: pointer;
  }

  .icon-tile {
    width: 96px;
    height: 96px;
    background-color: #ffffff;
    border-radius: 24px;
    justify-content: center;
    align-items: center;
  }

  .tag-grid {
    flex-direction: column;
  }

  .tag-row {
    flex-direction: row;
  }

  .cell-on {
    width: 8px;
    height: 8px;
    background-color: #111111;
  }

  .cell-off {
    width: 8px;
    height: 8px;
    background-color: #ffffff;
  }

  .icon-label {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    text-align: center;
  }
</style>
<div id="sticker-scan-button" class="icon-root">
  <div class="icon-tile">
    <div class="tag-grid">
      <div class="tag-row"><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div></div>
      <div class="tag-row"><div class="cell-on"></div><div class="cell-on"></div><div class="cell-on"></div><div class="cell-off"></div><div class="cell-on"></div><div class="cell-off"></div><div class="cell-off"></div><div class="cell-on"></div></div>
