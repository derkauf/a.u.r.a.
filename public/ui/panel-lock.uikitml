<!--
  Painel da fechadura (lock-porta-01).
  Elementos com id são ligados pelo AuraPanelSystem: device-status,
  control-power (+ control-power-label), control-cam, anchor-status.
  Não há linha de faixa: a fechadura tem trava/destrava + câmera.
  A câmera é SIMULADA (painel placeholder, sem feed real).
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 460px;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
    padding-right: 24px;
    gap: 14px;
    background-color: #101418;
    border-radius: 24px;
  }

  .eyebrow {
    color: #8a94a6;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .title {
    color: #ffffff;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.15;
  }

  .status {
    color: #7cfc9a;
    font-size: 24px;
  }

  .power-button {
    height: 72px;
    background-color: #2a9d8f;
    border-radius: 16px;
    justify-content: center;
    align-items: center;
  }

  .power-label {
    color: #ffffff;
    font-size: 26px;
    font-weight: 700;
  }

  .cam-button {
    height: 72px;
    background-color: #2c3440;
    border-radius: 16px;
    justify-content: center;
    align-items: center;
  }

  .cam-label {
    color: #ffffff;
    font-size: 26px;
    font-weight: 700;
  }

  .anchor {
    color: #8a94a6;
    font-size: 16px;
  }

  .hint {
    color: #5a6472;
    font-size: 16px;
  }
</style>
<Panel class="panel-root">
  <div id="txt-eyebrow" class="eyebrow">A.U.R.A. — LIVING ROOM</div>
  <div id="txt-title" class="title">Front door lock</div>
  <div id="device-status" class="status">Locked</div>
  <Button id="control-power" class="power-button">
    <ButtonLabel id="control-power-label" class="power-label">Unlock</ButtonLabel>
  </Button>
  <Button id="control-cam" class="cam-button">
    <ButtonLabel id="control-cam-label" class="cam-label">View camera</ButtonLabel>
  </Button>
  <div id="anchor-status" class="anchor">Anchor: waiting for XR session…</div>
  <div id="txt-hint" class="hint">Point with your hand and pinch to select.</div>
</Panel>
