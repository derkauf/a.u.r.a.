<!--
  Câmera da porta — SIMULADA (placeholder, sem feed real).
  Abre pelo botão "Ver câmera" do painel da fechadura e fecha pelo botão
  abaixo. Começa escondida (o AuraPanelSystem controla o display).
  Nenhuma imagem de câmera é capturada ou exibida no v1.
-->
<style>
  .camera-root {
    flex-direction: column;
    width: 460px;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
    padding-right: 24px;
    gap: 14px;
    background-color: #101418;
    border-radius: 24px;
  }

  .camera-eyebrow {
    color: #f5d90a;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .camera-view {
    flex-direction: column;
    height: 220px;
    background-color: #000000;
    border-radius: 16px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .camera-text {
    color: #ffffff;
    font-size: 26px;
    font-weight: 700;
    text-align: center;
  }

  .camera-sub {
    color: #8a94a6;
    font-size: 18px;
    text-align: center;
  }

  .camera-close-button {
    height: 72px;
    background-color: #2c3440;
    border-radius: 16px;
    justify-content: center;
    align-items: center;
  }

  .camera-close-label {
    color: #ffffff;
    font-size: 26px;
    font-weight: 700;
  }
</style>
<Panel class="camera-root">
  <div id="txt-camera-eyebrow" class="camera-eyebrow">DOOR CAMERA — SIMULATED</div>
  <div class="camera-view">
    <div id="txt-camera-text" class="camera-text">No live feed (v1)</div>
    <div id="txt-camera-sub" class="camera-sub">The camera is a placeholder. The live feed comes in a future version.</div>
  </div>
  <Button id="camera-close" class="camera-close-button">
    <ButtonLabel id="camera-close-label" class="camera-close-label">Close camera</ButtonLabel>
  </Button>
</Panel>
