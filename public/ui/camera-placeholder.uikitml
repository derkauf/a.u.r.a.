<!--
  Door camera — SIMULATED (placeholder, no live feed), in the Horizon OS
  window style. Opened by "View camera" in the lock window, closed by the
  X in the bar (id camera-close). Starts hidden (AuraPanelSystem controls
  the display). No camera image is captured or shown in v1.
  Static texts are translated by AuraLocalizationSystem.
-->
<style>
  .window-root {
    flex-direction: column;
    align-items: center;
    width: 400px;
    gap: 10px;
  }

  .window {
    flex-direction: column;
    align-self: stretch;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: #26282c;
    border-radius: 28px;
  }

  .camera-view {
    flex-direction: column;
    height: 200px;
    background-color: #000000;
    border-radius: 18px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .camera-text {
    color: #ffffff;
    font-size: 22px;
    font-weight: 700;
    text-align: center;
  }

  .camera-sub {
    color: #9aa0aa;
    font-size: 15px;
    text-align: center;
  }

  .bar {
    flex-direction: row;
    align-items: center;
    gap: 14px;
    height: 44px;
    padding-left: 18px;
    padding-right: 7px;
    background-color: #26282c;
    border-radius: 22px;
  }

  .bar-title {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
  }

  .bar-close {
    width: 30px;
    height: 30px;
    background-color: #3d4046;
    border-radius: 15px;
    justify-content: center;
    align-items: center;
    cursor: pointer;
  }

  .bar-close-label {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
  }
</style>
<div class="window-root">
  <div class="window">
    <div class="camera-view">
      <div id="txt-camera-text" class="camera-text">No live feed (v1)</div>
      <div id="txt-camera-sub" class="camera-sub">The camera is a placeholder. The live feed comes in a future version.</div>
    </div>
  </div>
  <div class="bar">
    <div id="txt-camera-eyebrow" class="bar-title">Door camera — simulated</div>
    <div id="camera-close" class="bar-close">
      <div class="bar-close-label">×</div>
    </div>
  </div>
</div>
